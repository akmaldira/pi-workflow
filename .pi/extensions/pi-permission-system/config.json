{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow"
    },
    "read": {
      "**/.env": "allow",
      "**/.env.local": "allow",
      "**/.env.*": "allow"
    },
    "write": {
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.*": "deny"
    },
    "edit": {
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "aws *": "allow",
      "gcloud *": "ask",
      "git push *": "ask",
      "psql *": "ask",
      "redis-cli *": "ask",
      "cp * .env": "deny",
      "cp * .env.local": "deny",
      "cp * .env.*": "deny",
      "> .env": "deny",
      "> .env.local": "deny",
      "> .env.*": "deny",
      "aws * create-*": "ask",
      "aws * put-*": "ask",
      "aws * delete-*": "ask",
      "aws * update-*": "ask",
      "aws * modify-*": "ask",
      "aws * replace-*": "ask",
      "aws * attach-*": "ask",
      "aws * detach-*": "ask",
      "aws * associate-*": "ask",
      "aws * disassociate-*": "ask",
      "aws * add-*": "ask",
      "aws * remove-*": "ask",
      "aws * register-*": "ask",
      "aws * deregister-*": "ask",
      "aws * enable-*": "ask",
      "aws * disable-*": "ask",
      "aws * start-*": "ask",
      "aws * stop-*": "ask",
      "aws * reboot-*": "ask",
      "aws * terminate-*": "ask",
      "aws * run-*": "ask",
      "aws * authorize-*": "ask",
      "aws * revoke-*": "ask",
      "aws * tag-*": "ask",
      "aws * untag-*": "ask",
      "aws * restore-*": "ask",
      "aws * reset-*": "ask",
      "aws * purge-*": "ask",
      "aws * copy-*": "ask",
      "aws * import-*": "ask",
      "aws * export-*": "ask",
      "aws * accept-*": "ask",
      "aws * reject-*": "ask",
      "aws * cancel-*": "ask",
      "aws * purchase-*": "ask",
      "aws * request-*": "ask",
      "aws * provision-*": "ask",
      "aws * invoke*": "ask",
      "aws * send-*": "ask",
      "aws s3 rm *": "ask",
      "aws s3 cp *": "ask",
      "aws s3 mv *": "ask",
      "aws s3 sync *": "ask",
      "aws s3api put-*": "ask",
      "aws s3api delete-*": "ask",
      "aws iam create-*": "ask",
      "aws iam delete-*": "ask",
      "aws iam attach-*": "ask",
      "aws iam detach-*": "ask",
      "aws iam put-*": "ask",
      "aws iam update-*": "ask",
      "aws * delete-bucket*": "deny",
      "aws * terminate-instances": "deny"
    },
    "external_directory": "allow"
  }
}
